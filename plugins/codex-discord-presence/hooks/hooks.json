{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/scripts/session-start.ts\"",
            "timeout": 10,
            "statusMessage": "Starting Discord Rich Presence"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/scripts/session-start.ts\" --update --start",
            "timeout": 10,
            "statusMessage": "Updating Discord Rich Presence"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/scripts/stop.ts\"",
            "timeout": 10,
            "statusMessage": "Stopping Discord Rich Presence"
          }
        ]
      }
    ]
  }
}
